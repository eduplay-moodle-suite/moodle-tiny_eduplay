{{!
    @template tiny_eduplay/insert

    Body of the dialog used to insert an EduPlay video link.

    Example context (json):
    {
        "selectedtext": "My lesson"
    }
}}
<form class="tiny_eduplay_form" novalidate>
    <div class="mb-3">
        <label for="tiny_eduplay_url">{{#str}}urllabel, tiny_eduplay{{/str}}</label>
        <input type="url" class="form-control" id="tiny_eduplay_url" data-eduplay="url"
               placeholder="https://eduplay.rnp.br/app/video/353479"
               aria-describedby="tiny_eduplay_urlhelp tiny_eduplay_urlerror" required>
        <div id="tiny_eduplay_urlhelp" class="form-text text-muted">{{#str}}urlhelp, tiny_eduplay{{/str}}</div>
        <div id="tiny_eduplay_urlerror" class="invalid-feedback d-none" data-eduplay="error" role="alert">
            {{#str}}urlinvalid, tiny_eduplay{{/str}}
        </div>
    </div>
    <div class="mb-3">
        <label for="tiny_eduplay_text">{{#str}}linktext, tiny_eduplay{{/str}}</label>
        <input type="text" class="form-control" id="tiny_eduplay_text" data-eduplay="text" value="{{selectedtext}}">
    </div>
</form>
